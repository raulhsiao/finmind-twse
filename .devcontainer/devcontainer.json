{
  "name": "uv-finmind-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "initializeCommand": "${localWorkspaceFolder}/.devcontainer/initializeCommand.sh ${localWorkspaceFolder}/.devcontainer",
  "runArgs": [
      "--env-file",
      "${localWorkspaceFolder}/.devcontainer/.env"
  ],
	"containerEnv": {
    	// "CLAUDE_CONFIG_DIR": "/home/raul/.claude",
		"ANTHROPIC_AUTH_TOKEN": "ollama",
		"ANTHROPIC_MODEL": "minimax-m2.7:cloud",
		"ANTHROPIC_API_KEY": "",
		"ANTHROPIC_BASE_URL": "http://172.16.16.42:11434",
		"CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
		"DISABLE_PROMPT_CACHING": "0"

  },
  
  // ---- Run as non-root vscode user ----
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,

  // ---- Workspace folder inside container ----
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=/opt/workspace/finmind-dev,target=/workspace,type=bind,consistency=cached",

  "mounts": [
      "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
      "source=${localWorkspaceFolder}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
      "source=${localWorkspaceFolder}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached"
  ],

  // ---- Forward Jupyter Lab port ----
  "forwardPorts": [28888],
  "portsAttributes": {
      "28888": {
          "label": "Jupyter Lab",
          "onAutoForward": "notify"
      }
  },
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/postCreateCommand.sh ${containerWorkspaceFolder}",
  "postStartCommand": "${containerWorkspaceFolder}/.devcontainer/postStartCommand.sh ${containerWorkspaceFolder} finmind 28888",

  "customizations": {
    "vscode": {
      "settings": {
				// "claudeCode.disableLoginPrompt": true,
				// "claudeCode.preferredLocation": "panel",
				// "claudeCode.selectedModel": "minimax-m2.7:cloud",
				"claudeCode.environmentVariables": [
					{ "name": "ANTHROPIC_AUTH_TOKEN", "value": "ollama" },
					{ "name": "ANTHROPIC_MODEL",    "value": "minimax-m2.7:cloud" },
					{ "name": "ANTHROPIC_API_KEY",    "value": "" },
					{ "name": "ANTHROPIC_BASE_URL",   "value": "http://172.16.16.42:11434" },
					{ "name": "CLAUDE_CODE_ATTRIBUTION_HEADER", "value": "0" },
					{ "name": "DISABLE_PROMPT_CACHING", "value": "0" }
				],
        "terminal.integrated.env.linux": {
            "VIRTUAL_ENV": "/workspace/finmind",
            "PATH": "~/.local/bin:/workspace/finmind/bin:${env:PATH}"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/workspace/finmind/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true
      },
      "extensions": [
        "mhutchie.git-graph",
        "anthropic.claude-code"
      ]
    }
  }
}
