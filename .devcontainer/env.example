# =============================================================================
# Environment Variables for FinMind Jupyter Lab Devcontainer
# =============================================================================
# Usage:
#   1. Copy this file to '.env' in the project root:
#        cp env.example .env
#   2. Fill in your actual values (do NOT quote them)
#   3. Rebuild or restart the devcontainer
#
# IMPORTANT:
#   - The '.env' file is git-ignored. NEVER commit it.
#   - This 'env.example' file is safe to commit (no secrets).
#   - Values are injected into the container via docker --env-file at runtime.
# =============================================================================

# ---- FinMind API token (https://finmindtrade.com/) ----
FINMIND_TOKEN=

# ANTHROPIC_BASE_URL=http://172.16.16.42:11434
ANTHROPIC_BASE_URL=
# ---- Anthropic API key (https://console.anthropic.com/) ----
# Optional. Used by Claude Code CLI when not authenticated via login.
ANTHROPIC_API_KEY=

# ---- GitHub personal access token (https://github.com/settings/tokens) ----
# Optional. Used by gh CLI for non-interactive operations.
GITHUB_TOKEN=

TZ=Asia/Taipei